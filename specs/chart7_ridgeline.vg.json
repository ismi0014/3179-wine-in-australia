{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "How reviewers scored each grape variety",
  "width": 700,
  "height": 420,
  "padding": {"left": 10, "top": 10, "right": 10, "bottom": 10},
  "layer": [
    {
      "data": {"url": "data/reviews_au.csv"},
      "transform": [
        {"filter": "datum.variety == 'Shiraz'"},
        {"density": "points", "groupby": ["variety"], "extent": [80, 100], "bandwidth": 1.2, "steps": 80},
        {"calculate": "-0", "as": "base"},
        {"calculate": "-0 + 11.7 * datum.density", "as": "top"}
      ],
      "mark": {"type": "area", "interpolate": "monotone", "fill": "#7b2d3b", "fillOpacity": 1, "stroke": "white", "strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "value", "type": "quantitative", "title": "Expert score (out of 100)", "scale": {"domain": [80, 100]}},
        "y": {"field": "top", "type": "quantitative", "axis": null, "scale": {"domain": [-7.05, 1.7], "nice": false}},
        "y2": {"field": "base"}
      }
    },
